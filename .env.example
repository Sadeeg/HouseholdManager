# HouseholdManager — lokale Konfiguration (VORLAGE)
#
# Kopieren:  cp .env.example .env   und Werte eintragen.
# .env ist in .gitignore — niemals committen, niemals in ein Issue kopieren.
#
# Format: Properties (KEY=VALUE). Der Backend liest die Datei über
# `spring.config.import` (siehe backend/src/main/resources/application.yml);
# Docker Compose nutzt sie für ${...}-Platzhalter.

# --- Nextcloud: Identity Provider (OIDC) -----------------------------------
# Das Backend ist Resource Server und validiert die **JWT-Access-Tokens**
# (RFC 9068), die der Nextcloud-OIDC-Client ausstellt. Die Signatur wird
# über den JWKS des Issuers geprüft — ein Client-Secret ist im Backend
# deshalb NICHT nötig.
#
# Es genügt EIN public Client für das Frontend (nur Client-ID, kein Secret):
#
#   docker exec -u www-data nextcloud php occ oidc:create "HouseholdManagerFrontend" \
#     "http://localhost:4200" --type=public --client_id="<32-64 Zeichen>" \
#     --resource_url="http://localhost:8080/api"
#
# Die Frontend-Client-ID steht in frontend/src/app/core/config/oidc.config.ts
# (öffentlicher Wert, kein Geheimnis).
#
# Ist der Issuer leer, startet das Backend OHNE Authentifizierung (Warnung
# im Log) — nur für die lokale Entwicklung, nie für den Betrieb.
nextcloud.oidc.issuer-uri=https://cloud.deeg-mail.de

# Client-ID des Frontend-Clients (öffentlich, kein Secret). Damit prüft das
# Backend, für welchen Client ein Token ausgestellt wurde: ohne diese Angabe
# würde ein Token jedes anderen Clients desselben Issuers die API öffnen.
# Wert übernehmen aus frontend/src/app/core/config/oidc.config.ts.
nextcloud.oidc.client-id=1b3ba5574d4542aeab30dc3211f23698dcbe404b46d193642f0152f5e9a46c78

# --- Nextcloud: Nutzerverzeichnis (OCS-API) --------------------------------
# Service-User in der Nextcloud-Admin-Gruppe + App-Password:
#
#   docker exec -u www-data nextcloud php occ user:add --password-from-env \
#     --display-name "HouseholdManager Service" householdmanager-svc -g admin
#   docker exec -u www-data nextcloud php occ user:auth-tokens:add \
#     householdmanager-svc --name householdmanager-local
#
# Ohne diese Werte ist die User-Suche deaktiviert (die Anwendung startet
# trotzdem).
nextcloud.base-url=https://cloud.deeg-mail.de
nextcloud.admin-user=householdmanager-svc
nextcloud.admin-app-password=

# --- Datenbank --------------------------------------------------------------
# Werte passend zu compose.yml.
DB_URL=jdbc:postgresql://localhost:5432/householdmanager
DB_USER=household
DB_PASSWORD=household

# --- Optional ---------------------------------------------------------------
# CORS-Origin des Frontends (Komma-getrennt bei mehreren)
# HOUSEHOLDMANAGER_ALLOWED_ORIGINS=http://localhost:4200
